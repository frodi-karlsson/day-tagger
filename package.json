    "eslint-plugin-astro": "^3",
    "eslint-plugin-import-x": "^4",
    "eslint-plugin-jsx-a11y": "^6",
    "eslint-plugin-solid": "^0",
    "globals": "^17",
    "happy-dom": "^20",
    "prettier": "^3",
    "prettier-plugin-astro": "^0",
    "typescript": "^6",
    "typescript-eslint": "^8",
