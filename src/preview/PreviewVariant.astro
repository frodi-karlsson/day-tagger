---
import { slugify } from '#src/string/slugify.js'

interface Props {
  description: string
}

const { description } = Astro.props
---

<section>
  <p>{description}</p>
  <div data-preview-variant={slugify(description)}>
    <slot />
  </div>
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  p {
    color: var(--color-text-muted);
    font-size: var(--font-size-2);
  }

  /* Fixed so the screenshot is a constant size. Sized by content, subpixel differences in
     text advance widths change the box by a pixel or two and comparison refuses to run. */
  div {
    width: 420px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-3);
  }
</style>
