---
import { Button, type ButtonSize, type ButtonVariant } from '#src/button/Button.js'
import PreviewPage from '#src/preview/PreviewPage.astro'
import PreviewVariant from '#src/preview/PreviewVariant.astro'

const variants: ButtonVariant[] = ['primary', 'secondary', 'ghost']
const sizes: ButtonSize[] = ['sm', 'md', 'lg']
const states = [
  { name: 'enabled', disabled: false },
  { name: 'disabled', disabled: true },
]
---

<PreviewPage title="Button">
  {
    variants.map((variant) =>
      states.map((state) => (
        <PreviewVariant description={`${variant}, ${state.name}`}>
          {sizes.map((size) => (
            <Button variant={variant} size={size} disabled={state.disabled} client:load>
              Save
            </Button>
          ))}
        </PreviewVariant>
      )),
    )
  }
</PreviewPage>
