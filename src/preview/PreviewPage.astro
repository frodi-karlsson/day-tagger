---
import '#src/design/index.scss'

interface Props {
  title: string
}

const { title } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} preview</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  /* Fixed rather than tokenised, so retuning --color-background cannot churn every snapshot. */
  main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    padding: var(--space-4);
    background: #fff;
  }

  @media (prefers-color-scheme: dark) {
    main {
      background: #000;
    }
  }
</style>
